#include <stdio.h>

int main() {
    int P[2][2] = {{7, 4}, {11, 15}};
    int C[2][2] = {{19, 0}, {3, 10}};
    int invP[2][2] = {{15, 22}, {15, 7}};
    int K[2][2];

    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
            K[i][j] = 0;
            for (int k = 0; k < 2; k++)
                K[i][j] += C[i][k] * invP[k][j];

            K[i][j] = (K[i][j] % 26 + 26) % 26;
        }
    }

    printf("Recovered Key Matrix:\n");
    for (int i = 0; i < 2; i++)
        printf("%d %d\n", K[i][0], K[i][1]);

    return 0;
}
