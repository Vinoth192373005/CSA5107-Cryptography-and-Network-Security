#include <stdio.h>
#include <ctype.h>
#include <string.h>

int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int modInverse(int a) {
    for (int i = 1; i < 26; i++) {
        if ((a * i) % 26 == 1)
            return i;
    }
    return -1;
}

void encrypt(char *message, int a, int b) {
    for (int i = 0; message[i] != '\0'; i++) {
        if (isalpha(message[i])) {
            char base = islower(message[i]) ? 'a' : 'A';
            int p = message[i] - base;
            message[i] = (a * p + b) % 26 + base;
        }
    }
}

void decrypt(char *message, int a, int b) {
    int inverse = modInverse(a);

    for (int i = 0; message[i] != '\0'; i++) {
        if (isalpha(message[i])) {
            char base = islower(message[i]) ? 'a' : 'A';
            int c = message[i] - base;
            int p = (inverse * (c - b) % 26 + 26) % 26;
            message[i] = p + base;
        }
    }
}

int main() {
    char message[1000];
    int a, b;

    printf("Enter plaintext: ");
    fgets(message, sizeof(message), stdin);
    message[strcspn(message, "\n")] = '\0';

    printf("Enter keys a and b: ");
    scanf("%d %d", &a, &b);

    a = (a % 26 + 26) % 26;
    b = (b % 26 + 26) % 26;

    if (gcd(a, 26) != 1) {
        printf("Invalid key! a must be relatively prime to 26.\n");
        return 1;
    }

    encrypt(message, a, b);
    printf("Encrypted message: %s\n", message);

    decrypt(message, a, b);
    printf("Recovered plaintext: %s\n", message);

    return 0;
}
