#include <stdio.h>
#include <stdlib.h>

int power(int a, int b, int n) {
    int r = 1;
    while (b > 0) {
        if (b % 2)
            r = (long long)r * a % n;
        a = (long long)a * a % n;
        b /= 2;
    }
    return r;
}

