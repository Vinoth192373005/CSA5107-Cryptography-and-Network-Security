#include <stdio.h>
#include <string.h>
#include <openssl/des.h>

int main() {
    DES_cblock key;
    DES_key_schedule schedule;
    DES_cblock input, encrypted, decrypted;
    int i;

    printf("Enter 8-character key: ");
    scanf("%8s", (char *)key);

    printf("Enter 8-character plaintext: ");
    scanf("%8s", (char *)input);

    DES_set_odd_parity(&key);
    DES_set_key_unchecked(&key, &schedule);

    DES_ecb_encrypt(&input, &encrypted, &schedule, DES_ENCRYPT);

    printf("\nEncrypted text (Hex): ");
    for (i = 0; i < 8; i++)
        printf("%02X", encrypted[i]);

    DES_ecb_encrypt(&encrypted, &decrypted, &schedule, DES_DECRYPT);

    printf("\nDecrypted text: ");
    for (i = 0; i < 8; i++)
        printf("%c", decrypted[i]);

    printf("\n");

    return 0;
}
