
#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 1000

double freq[26] = {
    8.12, 1.49, 2.71, 4.32, 12.02, 2.30, 2.03,
    5.92, 7.31, 0.10, 0.69, 3.98, 2.61, 6.95,
    7.68, 1.82, 0.11, 6.02, 6.28, 9.10, 2.88,
    1.11, 2.09, 0.17, 2.11, 0.07
};

int main() {
    char cipher[MAX], plain[26][MAX], temp[MAX];
    double score[26], tempScore;
    int key, i, j, n, top;

    printf("Enter ciphertext: ");
    fgets(cipher, MAX, stdin);
    cipher[strcspn(cipher, "\n")] = '\0';

    printf("Enter number of top plaintexts (1-26): ");
    scanf("%d", &top);

    if (top < 1 || top > 26) {
        printf("Invalid number.\n");
        return 1;
    }

    for (key = 0; key < 26; key++) {
        score[key] = 0;
        strcpy(plain[key], cipher);
        n = 0;

        for (i = 0; cipher[i]; i++) {
            if (isalpha((unsigned char)cipher[i])) {
                char base = islower((unsigned char)cipher[i]) ? 'a' : 'A';
                int c = cipher[i] - base;
                int p = (c - key + 26) % 26;

                plain[key][i] = base + p;
                score[key] += freq[p];
                n++;
            }
        }

        if (n > 0)
            score[key] /= n;
    }

    for (i = 0; i < 25; i++) {
        for (j = i + 1; j < 26; j++) {
            if (score[j] > score[i]) {
                tempScore = score[i];
                score[i] = score[j];
                score[j] = tempScore;

                strcpy(temp, plain[i]);
                strcpy(plain[i], plain[j]);
                strcpy(plain[j], temp);
            }
        }
    }

    printf("\nTop %d possible plaintexts:\n", top);
    for (i = 0; i < top; i++)
        printf("%d. %s\n", i + 1, plain[i]);

    return 0;
}
