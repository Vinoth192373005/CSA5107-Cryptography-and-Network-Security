#include <stdio.h>

int main() {
    int n, i, p[100], key, iv, c[100];
    int ecb[100], cbc[100], cfb[100];

    printf("Enter number of plaintext blocks: ");
    scanf("%d", &n);

    printf("Enter plaintext blocks (0-15): ");
    for (i = 0; i < n; i++)
        scanf("%d", &p[i]);

    printf("Enter key (0-15): ");
    scanf("%d", &key);

    printf("Enter IV (0-15): ");
    scanf("%d", &iv);

    /* Padding: append a 1-bit block marker,
       followed by zero bits as required. */
    p[n++] = 8;

    printf("\nECB Mode:\n");
    for (i = 0; i < n; i++) {
        ecb[i] = p[i] ^ key;
        printf("%d ", ecb[i]);
    }

    printf("\nCBC Mode:\n");
    for (i = 0; i < n; i++) {
        cbc[i] = p[i] ^ iv;
        cbc[i] ^= key;
        iv = cbc[i];
        printf("%d ", cbc[i]);
    }

    printf("\nCFB Mode:\n");
    iv = 0;
    for (i = 0; i < n; i++) {
        cfb[i] = p[i] ^ (key ^ iv);
        iv = cfb[i];
        printf("%d ", cfb[i]);
    }

    return 0;
}
