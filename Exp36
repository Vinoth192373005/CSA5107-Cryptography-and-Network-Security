
#include <stdio.h>
#include <string.h>

int gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int modInverse(int a) {
    for (int i = 1; i < 26; i++)
        if ((a * i) % 26 == 1)
            return i;
    return -1;
}

int main() {
    char text[100], encrypted[100], decrypted[100];
    int a, b, inv, i, p, c;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    a = (a % 26 + 26) % 26;
    b = (b % 26 + 26) % 26;

    if (gcd(a, 26) != 1) {
        printf("Encryption is not one-to-one.\n");
        printf("Decryption is not possible.\n");
        return 0;
    }

    inv = modInverse(a);

    for (i = 0; text[i] != '\0'; i++) {
        p = text[i] - 'A';
        c = (a * p + b) % 26;
        encrypted[i] = c + 'A';
    }
    encrypted[i] = '\0';

    for (i = 0; encrypted[i] != '\0'; i++) {
        c = encrypted[i] - 'A';
        p = (inv * (c - b + 26)) % 26;
        decrypted[i] = p + 'A';
    }
    decrypted[i] = '\0';

    printf("Encrypted text: %s\n", encrypted);
    printf("Decrypted text: %s\n", decrypted);

    return 0;
}
