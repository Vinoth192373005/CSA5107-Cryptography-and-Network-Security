
#include <stdio.h>
#include <string.h>

int mod(int x) {
    return (x % 26 + 26) % 26;
}

int inverse(int a) {
    int i;
    for (i = 1; i < 26; i++)
        if ((a * i) % 26 == 1)
            return i;
    return -1;
}

int main() {
    char p[100], c[100];
    int P[2][2], C[2][2], K[2][2];
    int det, inv, i, j;

    printf("Enter known plaintext (4 letters): ");
    scanf("%99s", p);

    printf("Enter corresponding ciphertext (4 letters): ");
    scanf("%99s", c);

    if (strlen(p) != 4 || strlen(c) != 4) {
        printf("Enter exactly 4 letters.\n");
        return 0;
    }

    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++) {
            if (p[i * 2 + j] < 'A' || p[i * 2 + j] > 'Z' ||
                c[i * 2 + j] < 'A' || c[i * 2 + j] > 'Z') {
                printf("Use uppercase letters only.\n");
                return 0;
            }

            P[i][j] = p[i * 2 + j] - 'A';
            C[i][j] = c[i * 2 + j] - 'A';
        }
    }

    det = mod(P[0][0] * P[1][1] - P[0][1] * P[1][0]);
    inv = inverse(det);

    if (inv == -1) {
        printf("Plaintext matrix is not invertible modulo 26.\n");
        return 0;
    }

    int Pinv[2][2];

    Pinv[0][0] = mod(inv * P[1][1]);
    Pinv[0][1] = mod(-inv * P[0][1]);
    Pinv[1][0] = mod(-inv * P[1][0]);
    Pinv[1][1] = mod(inv * P[0][0]);

    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++) {
            K[i][j] = mod(Pinv[i][0] * C[0][j] +
                          Pinv[i][1] * C[1][j]);
        }
    }

    printf("\nRecovered Key Matrix:\n");

    for (i = 0; i < 2; i++) {
        for (j = 0; j < 2; j++)
            printf("%d ", K[i][j]);
        printf("\n");
    }

    return 0;
}
