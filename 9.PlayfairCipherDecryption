#include <stdio.h>
#include <ctype.h>
#include <string.h>

char matrix[5][5];

void createMatrix(char *key) {
    int used[26] = {0}, k = 0;
    char seq[25];

    for (int i = 0; key[i]; i++) {
        char ch = toupper(key[i]);
        if (ch == 'J') ch = 'I';
        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            seq[k++] = ch;
            used[ch - 'A'] = 1;
        }
    }

    for (char ch = 'A'; ch <= 'Z'; ch++) {
        if (ch == 'J') continue;
        if (!used[ch - 'A']) {
            seq[k++] = ch;
            used[ch - 'A'] = 1;
        }
    }

    for (int i = 0; i < 25; i++)
        matrix[i / 5][i % 5] = seq[i];
}

void findPos(char ch, int *r, int *c) {
    if (ch == 'J') ch = 'I';
    for (int i = 0; i < 5; i++)
        for (int j = 0; j < 5; j++)
            if (matrix[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
}

void decrypt(char *text) {
    for (int i = 0; text[i] && text[i + 1]; i += 2) {
        int r1, c1, r2, c2;
        findPos(text[i], &r1, &c1);
        findPos(text[i + 1], &r2, &c2);

        if (r1 == r2) {
            text[i] = matrix[r1][(c1 + 4) % 5];
            text[i + 1] = matrix[r2][(c2 + 4) % 5];
        } else if (c1 == c2) {
            text[i] = matrix[(r1 + 4) % 5][c1];
            text[i + 1] = matrix[(r2 + 4) % 5][c2];
        } else {
            text[i] = matrix[r1][c2];
            text[i + 1] = matrix[r2][c1];
        }
    }
}

int main() {
    char key[100], text[500], ch;
    int k = 0;

    printf("Enter keyword: ");
    scanf("%99s", key);
    getchar();

    printf("Enter ciphertext:\n");
    while ((ch = getchar()) != EOF && k < 499) {
        if (isalpha((unsigned char)ch))
            text[k++] = toupper((unsigned char)ch);
    }
    text[k] = '\0';

    createMatrix(key);
    decrypt(text);

    printf("Decrypted plaintext: %s\n", text);
    return 0;
}
